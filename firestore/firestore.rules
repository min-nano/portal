rules_version = '2';

// クライアント SDK からのアクセスは全面拒否する。
//
// Firestore（共有設定 tool_settings など）へアクセスするのはバックエンド
// （Cloud Run の portal-api）だけで、こちらはランタイムサービスアカウントの
// IAM（roles/datastore.user）で認可されるサーバークライアントのため、この
// セキュリティルールの影響を受けない。ルールが影響するのはブラウザ等の
// クライアント SDK からの直接アクセスのみであり、それは一切許可しない。
//
// 将来クライアントから直接読ませたいデータができた場合に、そのパスだけを
// 明示的に allow で開けること（既定は deny のまま維持する）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
