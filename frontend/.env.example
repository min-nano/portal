# Clerk の Publishable Key（Clerk ダッシュボード → API Keys）。
# 公開されても問題ない値だが、環境ごとに異なるためリポジトリには含めない。
# ローカル開発ではこのファイルを .env にコピーして値を設定する。
# CI / デプロイではリポジトリ変数 CLERK_PUBLISHABLE_KEY から渡される。
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# ポータルの表示名（各ページのヘッダーと、トップページのタブ名）。
# 未設定なら「社内ポータル」になる。CI / デプロイではリポジトリ変数
# PORTAL_TITLE から渡される。
# VITE_PORTAL_TITLE=社内ポータル

# 本番のカスタムドメイン（ホスト名のみ）。設定すると <サイトID>.web.app /
# .firebaseapp.com へのアクセスをこのドメインへリダイレクトする。
# ローカル開発と PR プレビューはリダイレクト対象外なので、通常は空でよい。
# VITE_CANONICAL_HOST=portal.example.com
