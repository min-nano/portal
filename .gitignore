# Node
node_modules/
frontend/dist/

# Rust（計算実装）とそのビルド結果。.wasm はコミットせず、テストとデプロイの
# たびに core/build.sh で作り直す（リポジトリに古い実装が残らないように）。
# 手元で動かすときも、最初に 1 度 core/build.sh を実行すること。
core/target/
backend/app/wasm/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# カバレッジ計測の出力。CI はテストを走らせたジョブで作り、成果物として
# 持ち出す（リポジトリには残さない）。手元で測ったときも同じ場所に出る。
.coverage
core/coverage.xml
backend/coverage.xml
frontend/coverage/
coverage-*.xml
coverage-summary.json
diff-cover.json

# ローカル設定・秘密情報
.env
.env.local
*-service-account*.json

# Firebase CLI・エミュレータのキャッシュ
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
